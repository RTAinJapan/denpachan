{
  // C++ のビルドは build.ps1 (タスク「ビルド (全体)」) で行う。CMake Tools が開いたときに勝手に configure すると、
  // VCPKG_ROOT などが無いまま同じ out/build を触り、build.ps1 のビルドとぶつかるので止めておく
  "cmake.configureOnOpen": false,
  "cmake.automaticReconfigure": false,

  // ---- ファイルの形式 (保存したら必ず同じ形になるように) ----
  // 決まりは .editorconfig (EditorConfig の拡張機能が読む) と同じ。拡張機能が無くても同じになるよう、ここにも書く。
  // 改行コードは .gitattributes でも LF に固定している。確かめる・まとめて整える: tools/format/check.ps1
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.tabSize": 4,
  "editor.rulers": [140],

  // C++: 保存時に clang-format (.clang-format) で整える。C++ 拡張機能に付属の clang-format を使う
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_style": "file",
  "C_Cpp.clang_format_fallbackStyle": "none",
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },

  // C#: 保存時に C# 拡張機能で整える (.editorconfig の [*.cs])
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.formatOnSave": true
  },

  // JSON・YAML・XAML・Markdown・シェル・CMake は、書式を整える道具で全体を書き換えない
  // (試験のデータは 1 行に詰めて書くなど、手で並べた形を保つ)。上の空白・改行・文字コードの決まりだけ当てる
  "[json]": { "editor.tabSize": 2, "editor.formatOnSave": false },
  "[jsonc]": { "editor.tabSize": 2, "editor.formatOnSave": false },
  "[yaml]": { "editor.tabSize": 2, "editor.formatOnSave": false },
  "[xml]": { "editor.formatOnSave": false },
  "[markdown]": { "editor.formatOnSave": false },
  "[shellscript]": { "editor.formatOnSave": false },

  // PowerShell: Windows PowerShell 5.1 でも日本語が読めるよう BOM 付き UTF-8 で保存する。
  // 書式の整形はしない (PSScriptAnalyzer の警告は出る)
  "[powershell]": {
    "files.encoding": "utf8bom",
    "editor.formatOnSave": false
  },

  // XAML は XML として扱う (整形はしない。字下げは .editorconfig: XAML 4、csproj 2)
  "files.associations": {
    "*.xaml": "xml"
  }
}
