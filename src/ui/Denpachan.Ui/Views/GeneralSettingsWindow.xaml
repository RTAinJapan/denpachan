<Window x:Class="Denpachan.Ui.Views.GeneralSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全体設定" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, Yu Gothic UI" FontSize="13">
    <StackPanel Margin="18">
        <GroupBox Header="映像・音声" Foreground="{StaticResource DimTextBrush}">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CheckBox x:Name="AvSyncBox" Grid.ColumnSpan="2"
                          Content="映像と音声の同期" />
                <Label Grid.Row="1" Content="音声の余裕 (ms)" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="MarginBox" Width="100" Margin="0,3" />
                    <TextBlock Text="  デバイスのバッファに足す" Style="{StaticResource DimText}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Label Grid.Row="2" Content="映像途絶とみなす時間 (ms)" VerticalAlignment="Center" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="StallBox" Width="100" Margin="0,3" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Header="RTMPサーバ待ち受け設定" Margin="0,10,0,0" Foreground="{StaticResource DimTextBrush}">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="待ち受けアドレス" VerticalAlignment="Center" />
                <TextBox x:Name="BindBox" Grid.Column="1" Margin="0,3" />
                <Label Grid.Row="1" Content="ポート" VerticalAlignment="Center" />
                <TextBox x:Name="RtmpPortBox" Grid.Row="1" Grid.Column="1" Width="100" Margin="0,3" HorizontalAlignment="Left" />
                <Label Grid.Row="2" Content="無通信で切るまで (ms)" VerticalAlignment="Center" />
                <TextBox x:Name="IdleBox" Grid.Row="2" Grid.Column="1" Width="100" Margin="0,3" HorizontalAlignment="Left" />
            </Grid>
        </GroupBox>

        <GroupBox Header="FFmpeg" Margin="0,10,0,0" Foreground="{StaticResource DimTextBrush}">
            <StackPanel Margin="6">
                <DockPanel>
                    <Label Content="ffmpeg.exe" Width="90" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="確認" Margin="6,0,0,0" Click="CheckFfmpeg_Click" />
                    <Button DockPanel.Dock="Right" Content="参照…" Margin="6,0,0,0" Click="BrowseFfmpeg_Click" />
                    <TextBox x:Name="FfmpegBox" Margin="0,3" />
                </DockPanel>
                <TextBlock Style="{StaticResource DimText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="録画のCPUエンコードを利用する場合に設定。空欄の場合exeと同フォルダまたはPATHから探索" />
                <TextBlock x:Name="FfmpegStatus" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="ErrorText" Foreground="#FFF07178" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
        <TextBlock Text="変更すると、各チャンネル一度切断して再接続することがあります。" Style="{StaticResource DimText}"
                   FontSize="12" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="キャンセル" IsCancel="True" MinWidth="90" />
            <Button x:Name="SaveButton" Content="保存" IsDefault="True" MinWidth="90" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
