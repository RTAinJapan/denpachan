<Window x:Class="Denpachan.Ui.Views.ChannelSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Denpachan.Ui.Infrastructure"
        Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, Yu Gothic UI" FontSize="13">
    <StackPanel Margin="18">
      <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">
        <TabItem Header="{l:Tr channel.tabInput}">
        <StackPanel Margin="0,10,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="{l:Tr channel.name}" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,3" />
            <Label Grid.Row="1" Content="{l:Tr channel.input}" VerticalAlignment="Center" />
            <ComboBox x:Name="InputBox" Grid.Row="1" Grid.Column="1" Margin="0,3" SelectionChanged="InputBox_SelectionChanged">
                <ComboBoxItem Content="{l:Tr channel.inputSrtListener}" Tag="srt:listener" />
                <ComboBoxItem Content="{l:Tr channel.inputSrtCaller}" Tag="srt:caller" />
                <ComboBoxItem Content="{l:Tr channel.inputRtmpPush}" Tag="rtmp:push" />
                <ComboBoxItem Content="{l:Tr channel.inputRtmpPull}" Tag="rtmp:pull" />
            </ComboBox>
        </Grid>

        <!-- SRT -->
        <GroupBox x:Name="SrtPanel" Header="SRT" Margin="0,10,0,0" Foreground="{StaticResource DimTextBrush}">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="144" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label x:Name="HostLabel" VerticalAlignment="Center" />
                <TextBox x:Name="HostBox" Grid.Column="1" Margin="0,3" />
                <Label Grid.Row="1" Content="{l:Tr channel.port}" VerticalAlignment="Center" />
                <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Margin="0,3" Width="120" HorizontalAlignment="Left" />
                <Label Grid.Row="2" Content="latency (ms)" VerticalAlignment="Center" />
                <StackPanel Grid.Row="2" Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="LatencyBox" Margin="0,3" Width="120" />
                        <TextBlock Text="{l:Tr channel.latencyNote}" Style="{StaticResource DimText}" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0" />
                    </StackPanel>
                    <!-- 受信状況から出した推奨値 (受信中だけ) -->
                    <DockPanel x:Name="LatencyAdvicePanel" Margin="0,2,0,4">
                        <Button x:Name="ApplyLatencyButton" DockPanel.Dock="Right" Content="{l:Tr channel.applyLatency}" Margin="6,0,0,0"
                                VerticalAlignment="Top" Click="ApplyLatency_Click" />
                        <TextBlock x:Name="LatencyAdvice" Style="{StaticResource DimText}" FontSize="12" TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
                <Label Grid.Row="3" Content="{l:Tr channel.passphrase}" VerticalAlignment="Center" />
                <PasswordBox x:Name="PassphraseBox" Grid.Row="3" Grid.Column="1" Margin="0,3" />
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="PassphraseHint" Style="{StaticResource DimText}" FontSize="12" VerticalAlignment="Center" />
                    <CheckBox x:Name="ClearPassphraseBox" Content="{l:Tr channel.clearPassphrase}" Margin="12,0,0,0" />
                </StackPanel>
                <Label Grid.Row="5" Content="{l:Tr channel.pbkeylen}" VerticalAlignment="Center" />
                <ComboBox x:Name="PbkeylenBox" Grid.Row="5" Grid.Column="1" Margin="0,3" Width="160" HorizontalAlignment="Left">
                    <ComboBoxItem Content="{l:Tr channel.pbkeylenDefault}" Tag="0" />
                    <ComboBoxItem Content="AES-128" Tag="16" />
                    <ComboBoxItem Content="AES-192" Tag="24" />
                    <ComboBoxItem Content="AES-256" Tag="32" />
                </ComboBox>
                <Label Grid.Row="6" Content="Stream ID (caller)" VerticalAlignment="Center" />
                <TextBox x:Name="StreamIdBox" Grid.Row="6" Grid.Column="1" Margin="0,3" />
            </Grid>
        </GroupBox>

        <!-- RTMP push -->
        <GroupBox x:Name="PushPanel" Header="RTMP push" Margin="0,10,0,0" Foreground="{StaticResource DimTextBrush}">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="144" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="app" VerticalAlignment="Center" />
                <TextBox x:Name="AppBox" Grid.Column="1" Margin="0,3" TextChanged="PushUrl_Changed" />
                <Label Grid.Row="1" Content="{l:Tr channel.streamKey}" VerticalAlignment="Center" />
                <DockPanel Grid.Row="1" Grid.Column="1">
                    <Button DockPanel.Dock="Right" Content="{l:Tr channel.generateKey}" Margin="6,0,0,0" Click="GenerateKey_Click" />
                    <TextBox x:Name="KeyBox" Margin="0,3" TextChanged="PushUrl_Changed" FontFamily="Consolas" />
                </DockPanel>
                <Label Grid.Row="2" Content="{l:Tr channel.pushUrl}" VerticalAlignment="Center" />
                <DockPanel Grid.Row="2" Grid.Column="1">
                    <Button DockPanel.Dock="Right" Content="{l:Tr channel.copy}" Margin="6,0,0,0" Click="CopyUrl_Click" />
                    <TextBox x:Name="PushUrlBox" Margin="0,3" IsReadOnly="True" FontFamily="Consolas" />
                </DockPanel>
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DimText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="{l:Tr channel.nginxExample}" />
            </Grid>
        </GroupBox>

        <!-- RTMP pull -->
        <GroupBox x:Name="PullPanel" Header="RTMP pull" Margin="0,10,0,0" Foreground="{StaticResource DimTextBrush}">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="144" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Content="URL" VerticalAlignment="Center" />
                <TextBox x:Name="UrlBox" Grid.Column="1" Margin="0,3" FontFamily="Consolas" />
            </Grid>
        </GroupBox>

        <!-- 共通 -->
        <GroupBox Header="{l:Tr channel.output}" Margin="0,10,0,0" Foreground="{StaticResource DimTextBrush}">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="144" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="{l:Tr channel.playoutBuffer}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="BufferBox" Margin="0,3" Width="120" />
                    <TextBlock Text="{l:Tr channel.playoutBufferNote}" Style="{StaticResource DimText}" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0" />
                </StackPanel>
                <Label Grid.Row="1" Content="{l:Tr channel.audioMode}" VerticalAlignment="Center" />
                <ComboBox x:Name="AudioModeBox" Grid.Row="1" Grid.Column="1" Margin="0,3" Width="120" HorizontalAlignment="Left">
                    <ComboBoxItem Content="{l:Tr channel.audioModeShared}" Tag="shared" />
                    <ComboBoxItem Content="{l:Tr channel.audioModeExclusive}" Tag="exclusive" />
                </ComboBox>
                <Label Grid.Row="2" Content="{l:Tr channel.audioOffset}" VerticalAlignment="Center" />
                <TextBox x:Name="OffsetBox" Grid.Row="2" Grid.Column="1" Margin="0,3" Width="120" HorizontalAlignment="Left" />
                <CheckBox x:Name="FadeBox" Grid.Row="3" Grid.Column="1" Content="{l:Tr channel.fade}" />
            </Grid>
        </GroupBox>

        <TextBlock Text="{l:Tr channel.reconnectNote}" Style="{StaticResource DimText}" FontSize="12"
                   Margin="0,10,0,0" />
        </StackPanel>
        </TabItem>

        <!-- 録画 -->
        <TabItem Header="{l:Tr channel.tabRecord}">
            <StackPanel Margin="0,10,0,0">
                <CheckBox x:Name="RecordEnabledBox" Content="{l:Tr record.enabled}" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="{l:Tr record.dir}" VerticalAlignment="Center" />
                    <DockPanel Grid.Column="1">
                        <Button DockPanel.Dock="Right" Content="{l:Tr common.browse}" Margin="6,0,0,0" Click="BrowseDir_Click" />
                        <TextBox x:Name="RecordDirBox" Margin="0,3" TextChanged="Template_Changed" />
                    </DockPanel>
                    <Label Grid.Row="1" Content="{l:Tr record.template}" VerticalAlignment="Center" />
                    <TextBox x:Name="TemplateBox" Grid.Row="1" Grid.Column="1" Margin="0,3" FontFamily="Consolas" TextChanged="Template_Changed" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DimText}" FontSize="12" TextWrapping="Wrap"
                               Text="{l:Tr record.templateHelp}" />
                    <Label Grid.Row="3" Content="{l:Tr record.example}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TemplatePreview" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                               VerticalAlignment="Center" />
                    <Label Grid.Row="4" Content="{l:Tr record.replacement}" VerticalAlignment="Center" />
                    <TextBox x:Name="ReplacementBox" Grid.Row="4" Grid.Column="1" Width="60" Margin="0,3" HorizontalAlignment="Left" TextChanged="Template_Changed" />
                    <Label Grid.Row="5" Content="{l:Tr record.container}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ContainerBox" Grid.Row="5" Grid.Column="1" Width="120" Margin="0,3" HorizontalAlignment="Left" SelectionChanged="Template_Changed">
                        <ComboBoxItem Content="{l:Tr record.containerMkv}" Tag="mkv" />
                        <ComboBoxItem Content="MPEG-TS" Tag="ts" />
                    </ComboBox>
                    <Label Grid.Row="6" Content="{l:Tr record.gap}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="GapBox" Width="80" Margin="0,3" />
                    </StackPanel>
                    <Label Grid.Row="7" Content="{l:Tr record.maxSegment}" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="MaxSegmentBox" Width="80" Margin="0,3" />
                        <TextBlock Text="{l:Tr record.maxSegmentNote}" Style="{StaticResource DimText}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <Label Grid.Row="8" Content="{l:Tr record.minFree}" VerticalAlignment="Center" />
                    <TextBox x:Name="MinFreeBox" Grid.Row="8" Grid.Column="1" Width="80" Margin="0,3" HorizontalAlignment="Left" />
                </Grid>

                <GroupBox Header="{l:Tr record.method}" Margin="0,10,0,0" Foreground="{StaticResource DimTextBrush}">
                    <StackPanel Margin="6">
                        <RadioButton x:Name="PassthroughBox" Content="{l:Tr record.passthrough}" GroupName="mode"
                                     Checked="Mode_Changed" Margin="0,2" />
                        <RadioButton x:Name="EncodeBox" Content="{l:Tr record.encodeGpu}" GroupName="mode" Checked="Mode_Changed" Margin="0,2" />
                        <RadioButton x:Name="CpuEncodeBox" Content="{l:Tr record.encodeCpu}" GroupName="mode"
                                     Checked="Mode_Changed" Margin="0,2" />
                        <TextBlock x:Name="CpuNote" Style="{StaticResource DimText}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,2"
                                   Text="{l:Tr record.cpuNote}" />
                        <Grid x:Name="EncodePanel" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{l:Tr record.codecEncoder}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="CodecBox" Width="100" Margin="0,3,6,3">
                                    <ComboBoxItem Content="H.264" Tag="h264" />
                                    <ComboBoxItem Content="HEVC" Tag="hevc" />
                                    <ComboBoxItem Content="AV1" Tag="av1" />
                                </ComboBox>
                                <ComboBox x:Name="EncoderBox" Width="190" Margin="0,3">
                                    <ComboBoxItem Content="{l:Tr record.encoderAuto}" Tag="auto" />
                                    <ComboBoxItem Content="NVIDIA NVENC" Tag="nvenc" />
                                    <ComboBoxItem Content="Intel QSV" Tag="qsv" />
                                </ComboBox>
                            </StackPanel>
                            <Label Grid.Row="1" Content="{l:Tr record.rateControl}" VerticalAlignment="Center" />
                            <ComboBox x:Name="RcBox" Grid.Row="1" Grid.Column="1" Width="200" Margin="0,3" HorizontalAlignment="Left">
                                <ComboBoxItem Content="{l:Tr record.rcCbr}" Tag="cbr" />
                                <ComboBoxItem Content="{l:Tr record.rcVbr}" Tag="vbr" />
                                <ComboBoxItem Content="{l:Tr record.rcCqp}" Tag="cqp" />
                            </ComboBox>
                            <Label Grid.Row="2" Content="{l:Tr record.bitrateQp}" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="BitrateBox" Width="100" Margin="0,3" />
                                <TextBlock Text="QP" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBox x:Name="QpBox" Width="60" Margin="6,3" />
                            </StackPanel>
                            <Label Grid.Row="3" Content="{l:Tr record.preset}" VerticalAlignment="Center" />
                            <ComboBox x:Name="PresetBox" Grid.Row="3" Grid.Column="1" Width="230" Margin="0,3" HorizontalAlignment="Left">
                                <ComboBoxItem Content="{l:Tr record.presetP1}" Tag="p1" />
                                <ComboBoxItem Content="p2 (x264: superfast)" Tag="p2" />
                                <ComboBoxItem Content="p3 (x264: veryfast)" Tag="p3" />
                                <ComboBoxItem Content="{l:Tr record.presetP4}" Tag="p4" />
                                <ComboBoxItem Content="p5 (x264: fast)" Tag="p5" />
                                <ComboBoxItem Content="p6 (x264: medium)" Tag="p6" />
                                <ComboBoxItem Content="{l:Tr record.presetP7}" Tag="p7" />
                            </ComboBox>
                            <Label Grid.Row="4" Content="{l:Tr record.gop}" VerticalAlignment="Center" />
                            <TextBox x:Name="GopBox" Grid.Row="4" Grid.Column="1" Width="60" Margin="0,3" HorizontalAlignment="Left" />
                            <Label Grid.Row="5" Content="{l:Tr record.audioBitrate}" VerticalAlignment="Center" />
                            <TextBox x:Name="AudioBitrateBox" Grid.Row="5" Grid.Column="1" Width="80" Margin="0,3" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
                <TextBlock Text="{l:Tr record.applyNote}" Style="{StaticResource DimText}"
                           FontSize="12" Margin="0,10,0,0" />
            </StackPanel>
        </TabItem>
      </TabControl>

        <TextBlock x:Name="ErrorText" Foreground="#FFF07178" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{l:Tr common.cancel}" IsCancel="True" MinWidth="90" />
            <Button x:Name="SaveButton" Content="{l:Tr common.save}" IsDefault="True" MinWidth="90" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
