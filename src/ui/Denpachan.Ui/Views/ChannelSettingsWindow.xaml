<Window x:Class="Denpachan.Ui.Views.ChannelSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="チャンネルの設定" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, Yu Gothic UI" FontSize="13">
    <StackPanel Margin="18">
      <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">
        <TabItem Header="受信と出力">
        <StackPanel Margin="0,10,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="名前" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,3" />
            <Label Grid.Row="1" Content="入力" VerticalAlignment="Center" />
            <ComboBox x:Name="InputBox" Grid.Row="1" Grid.Column="1" Margin="0,3" SelectionChanged="InputBox_SelectionChanged">
                <ComboBoxItem Content="SRT (待ち受け / listener)" Tag="srt:listener" />
                <ComboBoxItem Content="SRT (接続しに行く / caller)" Tag="srt:caller" />
                <ComboBoxItem Content="RTMP push (Nginx などから受ける)" Tag="rtmp:push" />
                <ComboBoxItem Content="RTMP pull (Nginx などから取りに行く)" Tag="rtmp:pull" />
            </ComboBox>
        </Grid>

        <!-- SRT -->
        <GroupBox x:Name="SrtPanel" Header="SRT" Margin="0,10,0,0" Foreground="{StaticResource DimTextBrush}">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="144" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label x:Name="HostLabel" Content="待ち受けアドレス" VerticalAlignment="Center" />
                <TextBox x:Name="HostBox" Grid.Column="1" Margin="0,3" />
                <Label Grid.Row="1" Content="ポート" VerticalAlignment="Center" />
                <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Margin="0,3" Width="120" HorizontalAlignment="Left" />
                <Label Grid.Row="2" Content="latency (ms)" VerticalAlignment="Center" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="LatencyBox" Margin="0,3" Width="120" />
                    <TextBlock Text="  送出側と大きい方が使われる" Style="{StaticResource DimText}" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
                <Label Grid.Row="3" Content="パスフレーズ" VerticalAlignment="Center" />
                <PasswordBox x:Name="PassphraseBox" Grid.Row="3" Grid.Column="1" Margin="0,3" />
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="PassphraseHint" Style="{StaticResource DimText}" FontSize="12" VerticalAlignment="Center" />
                    <CheckBox x:Name="ClearPassphraseBox" Content="パスフレーズを消す" Margin="12,0,0,0" />
                </StackPanel>
                <Label Grid.Row="5" Content="鍵長" VerticalAlignment="Center" />
                <ComboBox x:Name="PbkeylenBox" Grid.Row="5" Grid.Column="1" Margin="0,3" Width="160" HorizontalAlignment="Left">
                    <ComboBoxItem Content="既定" Tag="0" />
                    <ComboBoxItem Content="AES-128" Tag="16" />
                    <ComboBoxItem Content="AES-192" Tag="24" />
                    <ComboBoxItem Content="AES-256" Tag="32" />
                </ComboBox>
                <Label Grid.Row="6" Content="Stream ID (caller)" VerticalAlignment="Center" />
                <TextBox x:Name="StreamIdBox" Grid.Row="6" Grid.Column="1" Margin="0,3" />
            </Grid>
        </GroupBox>

        <!-- RTMP push -->
        <GroupBox x:Name="PushPanel" Header="RTMP push" Margin="0,10,0,0" Foreground="{StaticResource DimTextBrush}">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="144" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="app" VerticalAlignment="Center" />
                <TextBox x:Name="AppBox" Grid.Column="1" Margin="0,3" TextChanged="PushUrl_Changed" />
                <Label Grid.Row="1" Content="ストリームキー" VerticalAlignment="Center" />
                <DockPanel Grid.Row="1" Grid.Column="1">
                    <Button DockPanel.Dock="Right" Content="生成" Margin="6,0,0,0" Click="GenerateKey_Click" />
                    <TextBox x:Name="KeyBox" Margin="0,3" TextChanged="PushUrl_Changed" FontFamily="Consolas" />
                </DockPanel>
                <Label Grid.Row="2" Content="送出側に設定する URL" VerticalAlignment="Center" />
                <DockPanel Grid.Row="2" Grid.Column="1">
                    <Button DockPanel.Dock="Right" Content="コピー" Margin="6,0,0,0" Click="CopyUrl_Click" />
                    <TextBox x:Name="PushUrlBox" Margin="0,3" IsReadOnly="True" FontFamily="Consolas" />
                </DockPanel>
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DimText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Nginx の例: application live { live on; push この URL; push_reconnect 1s; }" />
            </Grid>
        </GroupBox>

        <!-- RTMP pull -->
        <GroupBox x:Name="PullPanel" Header="RTMP pull" Margin="0,10,0,0" Foreground="{StaticResource DimTextBrush}">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="144" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Content="URL" VerticalAlignment="Center" />
                <TextBox x:Name="UrlBox" Grid.Column="1" Margin="0,3" FontFamily="Consolas" />
            </Grid>
        </GroupBox>

        <!-- 共通 -->
        <GroupBox Header="出力" Margin="0,10,0,0" Foreground="{StaticResource DimTextBrush}">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="144" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="再生バッファ (ms)" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="BufferBox" Margin="0,3" Width="120" />
                    <TextBlock Text="  0 = 最小遅延。カクつくなら 16 程度" Style="{StaticResource DimText}" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
                <Label Grid.Row="1" Content="音声の出力モード" VerticalAlignment="Center" />
                <ComboBox x:Name="AudioModeBox" Grid.Row="1" Grid.Column="1" Margin="0,3" Width="280" HorizontalAlignment="Left">
                    <ComboBoxItem Content="共有 (他のアプリと同時に使える)" Tag="shared" />
                    <ComboBoxItem Content="排他 (低遅延。通知音が混ざらない)" Tag="exclusive" />
                </ComboBox>
                <Label Grid.Row="2" Content="音声オフセット (ms)" VerticalAlignment="Center" />
                <TextBox x:Name="OffsetBox" Grid.Row="2" Grid.Column="1" Margin="0,3" Width="120" HorizontalAlignment="Left" />
                <CheckBox x:Name="FadeBox" Grid.Row="3" Grid.Column="1" Content="受信の開始・途絶の瞬間に短いフェードをかける (ノイズ防止)" />
            </Grid>
        </GroupBox>

        <TextBlock Text="受信の設定を変えると、このチャンネルは一度切断して再接続します。" Style="{StaticResource DimText}" FontSize="12"
                   Margin="0,10,0,0" />
        </StackPanel>
        </TabItem>

        <!-- 録画 -->
        <TabItem Header="録画">
            <StackPanel Margin="0,10,0,0">
                <CheckBox x:Name="RecordEnabledBox" Content="録画する" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="保存先" VerticalAlignment="Center" />
                    <DockPanel Grid.Column="1">
                        <Button DockPanel.Dock="Right" Content="参照…" Margin="6,0,0,0" Click="BrowseDir_Click" />
                        <TextBox x:Name="RecordDirBox" Margin="0,3" TextChanged="Template_Changed" />
                    </DockPanel>
                    <Label Grid.Row="1" Content="ファイル名" VerticalAlignment="Center" />
                    <TextBox x:Name="TemplateBox" Grid.Row="1" Grid.Column="1" Margin="0,3" FontFamily="Consolas" TextChanged="Template_Changed" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DimText}" FontSize="12" TextWrapping="Wrap"
                               Text="{}{ch} {name} {YYYY} {YY} {MM} {DD} {hh} {mm} {ss} {seq} {codec} {res}  / はフォルダの区切り" />
                    <Label Grid.Row="3" Content="例" VerticalAlignment="Center" />
                    <TextBlock x:Name="TemplatePreview" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                               VerticalAlignment="Center" />
                    <Label Grid.Row="4" Content="使えない文字の置き換え" VerticalAlignment="Center" />
                    <TextBox x:Name="ReplacementBox" Grid.Row="4" Grid.Column="1" Width="60" Margin="0,3" HorizontalAlignment="Left" TextChanged="Template_Changed" />
                    <Label Grid.Row="5" Content="形式" VerticalAlignment="Center" />
                    <ComboBox x:Name="ContainerBox" Grid.Row="5" Grid.Column="1" Width="280" Margin="0,3" HorizontalAlignment="Left" SelectionChanged="Template_Changed">
                        <ComboBoxItem Content="MKV (途中で止まっても再生できる)" Tag="mkv" />
                        <ComboBoxItem Content="MPEG-TS" Tag="ts" />
                    </ComboBox>
                    <Label Grid.Row="6" Content="途切れで区切る (秒)" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="GapBox" Width="80" Margin="0,3" />
                        <TextBlock Text="  映像がこの秒数来なければ次は別のファイル" Style="{StaticResource DimText}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <Label Grid.Row="7" Content="最大の長さ (分)" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="MaxSegmentBox" Width="80" Margin="0,3" />
                        <TextBlock Text="  0 = 無制限" Style="{StaticResource DimText}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <Label Grid.Row="8" Content="空き容量の下限 (GB)" VerticalAlignment="Center" />
                    <TextBox x:Name="MinFreeBox" Grid.Row="8" Grid.Column="1" Width="80" Margin="0,3" HorizontalAlignment="Left" />
                </Grid>

                <GroupBox Header="方式" Margin="0,10,0,0" Foreground="{StaticResource DimTextBrush}">
                    <StackPanel Margin="6">
                        <RadioButton x:Name="PassthroughBox" Content="パススルー (受信したまま保存。負荷ほぼゼロ、画質劣化なし)" GroupName="mode"
                                     Checked="Mode_Changed" Margin="0,2" />
                        <RadioButton x:Name="EncodeBox" Content="再エンコード (GPU: NVENC / QSV)" GroupName="mode" Checked="Mode_Changed" Margin="0,2" />
                        <RadioButton x:Name="CpuEncodeBox" Content="再エンコード (CPU: 外部 ffmpeg の x264 / x265 / SVT-AV1)" GroupName="mode"
                                     Checked="Mode_Changed" Margin="0,2" />
                        <TextBlock x:Name="CpuNote" Style="{StaticResource DimText}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,2"
                                   Text="ffmpeg.exe は全体の設定で指定します (空欄なら同じフォルダ → PATH)。CPU 負荷が高いので、4K では速いプリセットにしてください。" />
                        <Grid x:Name="EncodePanel" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="コーデック / エンコーダ" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="CodecBox" Width="100" Margin="0,3,6,3">
                                    <ComboBoxItem Content="H.264" Tag="h264" />
                                    <ComboBoxItem Content="HEVC" Tag="hevc" />
                                    <ComboBoxItem Content="AV1" Tag="av1" />
                                </ComboBox>
                                <ComboBox x:Name="EncoderBox" Width="190" Margin="0,3">
                                    <ComboBoxItem Content="自動 (NVENC → QSV)" Tag="auto" />
                                    <ComboBoxItem Content="NVIDIA NVENC" Tag="nvenc" />
                                    <ComboBoxItem Content="Intel QSV" Tag="qsv" />
                                </ComboBox>
                            </StackPanel>
                            <Label Grid.Row="1" Content="レート制御" VerticalAlignment="Center" />
                            <ComboBox x:Name="RcBox" Grid.Row="1" Grid.Column="1" Width="200" Margin="0,3" HorizontalAlignment="Left">
                                <ComboBoxItem Content="CBR (固定ビットレート)" Tag="cbr" />
                                <ComboBoxItem Content="VBR (可変ビットレート)" Tag="vbr" />
                                <ComboBoxItem Content="固定 QP (量子化)" Tag="cqp" />
                            </ComboBox>
                            <Label Grid.Row="2" Content="ビットレート (kbps) / QP" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="BitrateBox" Width="100" Margin="0,3" />
                                <TextBlock Text="  QP" VerticalAlignment="Center" />
                                <TextBox x:Name="QpBox" Width="60" Margin="6,3" />
                            </StackPanel>
                            <Label Grid.Row="3" Content="プリセット" VerticalAlignment="Center" />
                            <ComboBox x:Name="PresetBox" Grid.Row="3" Grid.Column="1" Width="230" Margin="0,3" HorizontalAlignment="Left">
                                <ComboBoxItem Content="p1 最速 (x264: ultrafast)" Tag="p1" />
                                <ComboBoxItem Content="p2 (x264: superfast)" Tag="p2" />
                                <ComboBoxItem Content="p3 (x264: veryfast)" Tag="p3" />
                                <ComboBoxItem Content="p4 標準 (x264: faster)" Tag="p4" />
                                <ComboBoxItem Content="p5 (x264: fast)" Tag="p5" />
                                <ComboBoxItem Content="p6 (x264: medium)" Tag="p6" />
                                <ComboBoxItem Content="p7 高画質 (x264: slow)" Tag="p7" />
                            </ComboBox>
                            <Label Grid.Row="4" Content="キーフレーム間隔 (秒)" VerticalAlignment="Center" />
                            <TextBox x:Name="GopBox" Grid.Row="4" Grid.Column="1" Width="60" Margin="0,3" HorizontalAlignment="Left" />
                            <Label Grid.Row="5" Content="音声 AAC (kbps)" VerticalAlignment="Center" />
                            <TextBox x:Name="AudioBitrateBox" Grid.Row="5" Grid.Column="1" Width="80" Margin="0,3" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
                <TextBlock Text="録画の設定は受信を止めずに反映されます (録画中のファイルは区切られます)。" Style="{StaticResource DimText}"
                           FontSize="12" Margin="0,10,0,0" />
            </StackPanel>
        </TabItem>
      </TabControl>

        <TextBlock x:Name="ErrorText" Foreground="#FFF07178" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="キャンセル" IsCancel="True" MinWidth="90" />
            <Button x:Name="SaveButton" Content="保存" IsDefault="True" MinWidth="90" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
