<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 配信卓で使うので暗い配色。状態色は一目で分かるものにする。 -->
    <Color x:Key="BgColor">#FF1E1F22</Color>
    <Color x:Key="PanelColor">#FF2B2D31</Color>
    <Color x:Key="PanelHiColor">#FF34373D</Color>
    <Color x:Key="BorderColor">#FF3F4248</Color>
    <Color x:Key="TextColor">#FFDCDDDE</Color>
    <Color x:Key="DimTextColor">#FF9A9CA3</Color>
    <Color x:Key="AccentColor">#FF5B8DEF</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelHiBrush" Color="{StaticResource PanelHiColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="DimTextBrush" Color="{StaticResource DimTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <SolidColorBrush x:Key="LiveBrush" Color="#FF2FA35A" />
    <SolidColorBrush x:Key="HoldBrush" Color="#FFC98A1A" />
    <SolidColorBrush x:Key="WaitingBrush" Color="#FF4C5058" />
    <SolidColorBrush x:Key="StoppedBrush" Color="#FF30333A" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFC7393F" />

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="DimText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource PanelHiBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style TargetType="ToggleButton" x:Key="ToggleChip">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource PanelHiBrush}" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 録画ボタン (オンのとき赤) -->
    <Style x:Key="RecordChip" TargetType="ToggleButton" BasedOn="{StaticResource ToggleChip}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FFC7393F" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox / TextBox / CheckBox などは WPF の Fluent テーマ (App.xaml の ThemeMode="Dark") に任せる -->

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        <Setter Property="Padding" Value="0,4,10,4" />
    </Style>

    <!-- 状態表示の丸いラベル -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="Background" Value="{StaticResource StoppedBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKind}" Value="live">
                <Setter Property="Background" Value="{StaticResource LiveBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="hold">
                <Setter Property="Background" Value="{StaticResource HoldBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="waiting">
                <Setter Property="Background" Value="{StaticResource WaitingBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="starting">
                <Setter Property="Background" Value="{StaticResource WaitingBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="restarting">
                <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
            </DataTrigger>
            <!-- RTMP pull / SRT caller で相手に繋がらない -->
            <DataTrigger Binding="{Binding StatusKind}" Value="unreachable">
                <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
