<Project Sdk="Microsoft.NET.Sdk">

  <!-- denpachan の操作画面 (設計書 §9)。engine とは名前付きパイプと共有メモリでしかつながらない。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>denpachan</AssemblyName>
    <RootNamespace>Denpachan.Ui</RootNamespace>
    <Version>0.1.0</Version>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
    <!-- WPF の Fluent テーマ (ThemeMode) は試験的 API 扱い -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

</Project>
