<Project Sdk="Microsoft.NET.Sdk">

  <!-- denpachan の操作画面 (設計書 §9)。engine とは名前付きパイプと共有メモリでしかつながらない。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>denpachan</AssemblyName>
    <RootNamespace>Denpachan.Ui</RootNamespace>
    <!-- 版は CMakeLists.txt の project(denpachan ... VERSION x.y.z) だけに書き、ここはそれを読む
         (C++ と画面、配布の zip、リリースのタグで同じ版にするため。docs/development.md の「リリース」) -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\..\CMakeLists.txt')), '(?&lt;=project\(denpachan[^)]*VERSION )[0-9]+\.[0-9]+\.[0-9]+'))</Version>
    <!-- プレリリースのラベル (rc.1 など)。build.ps1 -VersionLabel が渡す。画面のタイトルに出る版 (InformationalVersion) に付く -->
    <InformationalVersion Condition="'$(DenpachanVersionLabel)' != ''">$(Version)-$(DenpachanVersionLabel)</InformationalVersion>
    <Product>denpachan</Product>
    <Company>RTA in Japan</Company>
    <Copyright>Copyright (c) 2026 RTA in Japan. GPL-3.0</Copyright>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
    <!-- exe のアイコン。ウィンドウとタスクバーもこれを使う (元は assets/denpachan.svg) -->
    <ApplicationIcon>..\..\..\assets\denpachan.ico</ApplicationIcon>
    <!-- WPF の Fluent テーマ (ThemeMode) は試験的 API 扱い -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- dotnet watch (VS Code のタスク「画面: 文言を確認」) で XAML の変更も拾う。
       XAML はビルド時に BAML になるのでホットリロードが効かない。ホットリロードを切って (no-hot-reload)、
       ビルドし直して起動し直す -->
  <ItemGroup>
    <Watch Include="**\*.xaml;Lang\*.json" Exclude="bin\**;obj\**" />
  </ItemGroup>

  <!-- 画面の文言 (Infrastructure/Loc.cs)。言語ごとに 1 ファイルで、exe に埋め込む -->
  <ItemGroup>
    <EmbeddedResource Include="Lang\*.json" LogicalName="lang.%(Filename).json" />
  </ItemGroup>

</Project>
