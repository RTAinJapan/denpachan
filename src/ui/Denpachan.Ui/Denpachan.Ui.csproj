<Project Sdk="Microsoft.NET.Sdk">

  <!-- denpachan の操作画面 (設計書 §9)。engine とは名前付きパイプと共有メモリでしかつながらない。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>denpachan</AssemblyName>
    <RootNamespace>Denpachan.Ui</RootNamespace>
    <Version>0.1.0</Version>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
    <!-- WPF の Fluent テーマ (ThemeMode) は試験的 API 扱い -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- dotnet watch (VS Code のタスク「画面: 文言を確認」) で XAML の変更も拾う。
       XAML はビルド時に BAML になるのでホットリロードが効かない。ホットリロードを切って (no-hot-reload)、
       ビルドし直して起動し直す -->
  <ItemGroup>
    <Watch Include="**\*.xaml" Exclude="bin\**;obj\**" />
  </ItemGroup>

</Project>
